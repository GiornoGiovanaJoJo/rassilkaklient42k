# Образец окружения.
#
# На боевом сервере этот файл создаёт деплой — из секрета APP_ENV в GitHub
# (Settings → Secrets and variables → Actions). Правится там же: следующая
# выкатка перезапишет .env на сервере содержимым секрета, поэтому единственный
# источник правды — секрет, а не файл на сервере.
#
# Вручную (без GitHub) — просто скопировать и заполнить:
#   cp .env.example .env && nano .env

# --- Общее ---------------------------------------------------------------
# Ключ подписи сессий. Сгенерировать свой, не оставлять этот:
#   openssl rand -hex 32
DJANGO_SECRET_KEY=__ЗАМЕНИТЬ__

DJANGO_DEBUG=0
TIME_ZONE=Europe/Moscow
LOG_LEVEL=INFO

# --- База данных ---------------------------------------------------------
# Пароль придумать свой. Наружу база не смотрит, но пароль всё равно нужен
# стойкий: к ней есть доступ из любого контейнера в той же сети.
POSTGRES_DB=rassilka
POSTGRES_USER=rassilka
POSTGRES_PASSWORD=__ЗАМЕНИТЬ__

# --- Адрес сервиса -------------------------------------------------------
# По нему строятся ссылки отписки и счётчики открытий в письмах. Указывать
# адрес, по которому сервис доступен ИЗВНЕ: получатель письма открывает ссылку
# из интернета, а не изнутри сервера.
PUBLIC_BASE_URL=http://ВАШ_АДРЕС

# Порт, на котором сервис слушает снаружи. 80 — чтобы сайт открывался без
# указания порта в адресе.
APP_PORT=80

# Сколько процессов веб-приложения держать. На 2 ГБ памяти — 2.
WEB_WORKERS=2

# --- Лицензия ------------------------------------------------------------
# В этой сборке проверка ключа выключена: сервис стоит на собственном сервере.
# Код проверки не вырезан — включается значением 1, но тогда на сервере должен
# лежать ключ, выпущенный под его machine-id, иначе сервис отдаёт 503.
# LICENSE_REQUIRED=1

# --- Первый вход ---------------------------------------------------------
# Создаётся один раз, при установке на пустую базу: завести пользователя иначе
# неоткуда — в системе их заводит только существующий администратор.
# После первого входа переменные можно убрать, учётная запись останется.
# Пароль не короче 10 символов, иначе учётная запись не создастся.
CBMAIL_ADMIN_LOGIN=admin
CBMAIL_ADMIN_PASSWORD=__ЗАМЕНИТЬ__
CBMAIL_ADMIN_EMAIL=admin@example.ru

# --- Почтовые ящики ------------------------------------------------------
# Заводятся при установке, чтобы не перепечатывать хост, порт и пароль руками
# в интерфейсе. Нумерация с 1, подряд; любой ящик можно описать не полностью —
# тогда он пропускается с записью в журнале.
#
# SECURITY: ssl (порт 465 по умолчанию) | tls (587) | none.
#   Порт и способ шифрования должны совпадать: 465 со STARTTLS не отвечает
#   ошибкой, а висит до таймаута — сервер ждёт TLS с первого байта.
# PROJECT — необязательная группа ящиков, по ней фильтруются отправители при
#   создании рассылки. Проект создаётся, если его ещё нет.
#
# Уже заведённый профиль повторная выкатка НЕ трогает: пароль, исправленный в
# интерфейсе, иначе откатывался бы к значению отсюда при каждом перезапуске.
#
# CBMAIL_SMTP_1_TITLE=Основная почта
# CBMAIL_SMTP_1_HOST=smtp.mail.ru
# CBMAIL_SMTP_1_PORT=465
# CBMAIL_SMTP_1_SECURITY=ssl
# CBMAIL_SMTP_1_USER=info@example.ru
# CBMAIL_SMTP_1_PASSWORD=__ЗАМЕНИТЬ__
# CBMAIL_SMTP_1_FROM=info@example.ru
# CBMAIL_SMTP_1_PROJECT=Основной
